# Copy this file to .env and fill in your own values. NEVER commit .env to GitHub.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL connection string (Neon dashboard -> Connect -> copy the URL)
# Leave empty to use a local SQLite file instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Front-end URLs allowed to call the API (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Default administrator created by "python manage.py seed"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@pikiora.co.nz
